{
    "http": {
        "threads": 20,
        "timeout": 10,
        "retries": 2,
        "allow_redirects": false,
        "verify_ssl": false,
        "headers": {
            "User-Agent": "Reconistrator"
        }
    },
    "filters": {
        "status_include": [],
        "status_exclude": [404],
        "hide_lengths": []
    },
    "tools": {
        "directories": {
            "engine": "ffuf",
            "binary": null,
            "autocalibrate": true,
            "extra_args": []
        },
        "files": {
            "binary": null,
            "autocalibrate": true,
            "extra_args": []
        },
        "params": {
            "binary": null,
            "autocalibrate": true,
            "value": "1",
            "extra_args": []
        }
    },
    "active_recon": {
        "find_files": {
            "extensions": [".html", ".js", ".txt", ".xml",
                          ".json", ".bak", ".old", ".zip", ".tar", ".gz", ".sql",
                          ".log", ".conf", ".config", ".db"]
        }
    },
    "wordlist": {
        "endpoints": "../data/wordlists/directory_list.txt",
        "parameters": "../data/wordlists/burp-parameter-names.txt",
        "files": "../data/wordlists/directory_list.txt"
    }
}
